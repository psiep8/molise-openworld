{
  "name": "molise-openworld",
  "private": true,
  "version": "0.1.0",
  "description": "Open-world demo (walk + drive) built on open geodata of Palata (CB) and neighbouring villages, Molise, Italy.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:demo": "vite --host 127.0.0.1 --port 5173 --mode demo",
    "world:demo": "node scripts/serve-demo-world-tiles.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "geo": "node scripts/fetch-geodata.mjs",
    "geo:audit": "node scripts/geo-audit.mjs",
    "geo:imagery": "node scripts/fetch-world-imagery.mjs",
    "geo:imagery:hd": "node scripts/fetch-world-imagery.mjs --hd",
    "canopy": "node scripts/fetch-canopy.mjs",
    "landcover": "node scripts/fetch-landcover.mjs",
    "textures": "node scripts/fetch-textures.mjs",
    "kit": "node scripts/fetch-citykit.mjs",
    "worldkit": "node scripts/import-world-glb.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "streets": "node scripts/check-street-imagery.mjs",
    "check:cars": "node scripts/check-cars.mjs",
    "cars": "node scripts/cars.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "geotiff": "^2.1.3",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
