# Optional XYZ tile endpoint that you host or are licensed to use.
# Keep both values empty to use only the local Sentinel-2 mosaic.
VITE_OPEN_IMAGERY_TILE_URL=
VITE_OPEN_IMAGERY_ATTRIBUTION=

# Optional geographic bundle endpoint you host or are licensed to use.
# Each response must be a schemaVersion 1 JSON bundle; see README for its shape.
VITE_OPEN_WORLD_DATA_TILE_URL=
VITE_OPEN_WORLD_DATA_ATTRIBUTION=
